    "wrangler": "user-invocable-only",
    "web-perf": "user-invocable-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "loop": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "fewer-permission-prompts": "name-only",
    "keybindings-help": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:skill-creator": "name-only",
    "anthropic-skills:explain-usage": "name-only",
    "diagram-design:doctor": "name-only",
    "diagram-design:export-diagram": "name-only",
    "diagram-design:import-drawio": "name-only",
    "diagram-design:profile": "name-only",
    "obsidian:json-canvas": "name-only",
    "obsidian:obsidian-bases": "name-only",
    "obsidian:obsidian-cli": "name-only",
    "obsidian:obsidian-markdown": "name-only",
    "anthropic-skills:consolidate-memory": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:setup-claude": "off",
    "anthropic-skills:schedule": "off"
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "enabledPlugins": {
    "obsidian@obsidian-skills": true,
    "diagram-design@diagram-design": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "refuse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-destructive.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/read-gate.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/agent-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/post-edit.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/check-eol.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
