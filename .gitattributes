# Zeilenenden deterministisch halten, damit Windows-Checkouts keine
# Phantom-Diffs erzeugen.
* text=auto

# PowerShell-Skripte werden unter Windows mit CRLF ausgecheckt.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Sicherungen der Steuerdateien bleiben byte-exakt (CRLF/LF wie im Original).
archiv/** -text
